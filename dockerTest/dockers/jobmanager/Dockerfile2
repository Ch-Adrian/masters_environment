FROM openjdk:11-jdk-slim

ENV FLINK_VERSION=1.17.2

# Download and install Flink
RUN apt-get update && apt-get install -y curl tar gzip && \
    curl -O https://downloads.apache.org/flink/flink-${FLINK_VERSION}/flink-${FLINK_VERSION}-bin-scala_2.12.tgz && \
    tar xzf flink-${FLINK_VERSION}-bin-scala_2.12.tgz -C /opt && \
    rm flink-${FLINK_VERSION}-bin-scala_2.12.tgz && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/flink-${FLINK_VERSION}/bin:${PATH}"

USER root

#ENV FLINK_PROPERTIES="\
#jobmanager.rpc.address: jobmanager\n\
#taskmanager.numberOfTaskSlots: 4\n\
#jobmanager.memory.process.size: 2048m\n\
#taskmanager.memory.process.size: 4096m\n\
#rest.port: 8081\n\
#rest.address: 0.0.0.0\n\
#jobmanager.bind-host: 0.0.0.0\n\
#taskmanager.bind-host: 0.0.0.0\n\
#rest.bind-address: 0.0.0.0\n\
#blob.server.port: 6124\n\
#query.server.port: 6125"

# Install system dependencies for BCC/eBPF and building from source
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    net-tools \
    sudo \
    zip \
    openjdk-11-jdk \
    vim \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y python-is-python3

EXPOSE 8081
EXPOSE 6123

WORKDIR /
RUN mkdir taskmanager-logs
RUN mkdir taskmanager-logs/logs
RUN mkdir taskmanager-logs/scripts

