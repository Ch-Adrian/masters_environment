FROM openjdk:11-jdk-slim

ENV FLINK_VERSION=1.17.2

# Download and install Flink
RUN apt-get update && apt-get install -y curl tar gzip && \
    curl -O https://downloads.apache.org/flink/flink-${FLINK_VERSION}/flink-${FLINK_VERSION}-bin-scala_2.12.tgz && \
    tar xzf flink-${FLINK_VERSION}-bin-scala_2.12.tgz -C /opt && \
    rm flink-${FLINK_VERSION}-bin-scala_2.12.tgz && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/flink-${FLINK_VERSION}/bin:${PATH}"

USER root

# Install system dependencies for BCC/eBPF and building from source
RUN apt-get update && apt-get install -y \
    bison \
    build-essential \
    cmake \
    flex \
    git \
    clang \
    llvm \
    libclang-dev \
    llvm-dev \
    libelf-dev \
    python3 \
    python3-pip \
    libbpf-dev \
    iproute2 \
    net-tools \
    sudo \
    zip \
    kmod \
    openjdk-11-jdk \
    vim \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y python-is-python3

# Clone and build BCC from source (classic tools)
RUN git clone https://github.com/iovisor/bcc.git /bcc && \
    mkdir /bcc/build && cd /bcc/build && \
    cmake .. && make && make install && \
    rm -rf /bcc

# Install Python BCC package
RUN pip3 install bcc

